# ──────────────────────────────────────────────────────────
# Variables de entorno para GameStore AI
# Copia este archivo como .env y completa con tus valores
# ──────────────────────────────────────────────────────────

# API Key de Google Gemini (REQUERIDA)
# Obtenla gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# URL de conexion a la base de datos
DATABASE_URL=sqlite:///./data/gamestore.db

# Entorno de ejecucion
ENVIRONMENT=development
